generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_ADMIN
  ORDER_ADMIN
  ANALYST
  ADMIN
}

enum ProductType {
  COURSE
  VIDEO_COURSE
  WEBINAR
  MASTERCLASS
  CONSULTATION
  EBOOK
  PDF_GUIDE
  AUDIO
}

enum DemoType {
  VIDEO
  PDF
  IMAGE
  TEXT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  PENDING
  CHECKING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  CHECKING_PAYMENT
  PAID
  PREPARING
  ACCESS_GRANTED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  REJECTED
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  PURCHASE
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  type               ProductType
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])

  shortDescription   String?
  fullDescription    String?
  mainImage          String?
  gallery            String[]  @default([])
  videoUrl           String?

  forWhom            String?
  results            String?
  curriculum         Json?
  duration           String?
  format             String?
  instructorInfo     String?
  certificateAvailable Boolean @default(false)
  accessDurationDays Int?
  guaranteeTerms     String?

  price              Decimal   @db.Decimal(12, 2)
  discountPrice      Decimal?  @db.Decimal(12, 2)
  discountEndsAt     DateTime?

  isActive           Boolean   @default(true)
  isFeatured         Boolean   @default(false)
  isNew              Boolean   @default(false)
  isBestseller       Boolean   @default(false)
  viewCount          Int       @default(0)

  seoTitle           String?
  seoDescription     String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tariffs            Tariff[]
  demoMaterials      DemoMaterial[]
  reviews            Review[]
  orderItems         OrderItem[]
  leads              Lead[]
  abandonedCheckouts AbandonedCheckout[]
  analyticsEvents    AnalyticsEvent[]

  @@index([categoryId])
  @@index([type])
  @@index([isActive])
}

model Tariff {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String
  price              Decimal  @db.Decimal(12, 2)
  discountPrice      Decimal? @db.Decimal(12, 2)
  features           String[] @default([])
  bonuses            String?
  accessDurationDays Int?
  sortOrder          Int      @default(0)

  orderItems         OrderItem[]
  abandonedCheckouts AbandonedCheckout[]

  @@index([productId])
}

model DemoMaterial {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      DemoType
  title     String
  url       String?
  content   String?
  sortOrder Int      @default(0)

  @@index([productId])
}

model Review {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName  String
  customerImage String?
  textContent   String?
  videoUrl      String?
  rating        Int      @default(5)
  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([isApproved])
}

model PromoCode {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType
  value           Decimal      @db.Decimal(12, 2)
  expiresAt       DateTime?
  usageLimit      Int?
  usedCount       Int          @default(0)
  minOrderAmount  Decimal?     @db.Decimal(12, 2)
  productIds      String[]     @default([])
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  orders          Order[]
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique

  customerName     String
  customerLastName String?
  phone            String
  telegramUsername String?
  email            String?
  comment          String?
  internalNote     String?

  subtotal         Decimal       @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  promoCodeId      String?
  promoCode        PromoCode?    @relation(fields: [promoCodeId], references: [id])
  totalAmount      Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal      @default(0) @db.Decimal(12, 2)
  remainingAmount   Decimal      @default(0) @db.Decimal(12, 2)

  paymentMethod    String?
  paymentStatus    PaymentStatus @default(PENDING)
  orderStatus      OrderStatus   @default(NEW)

  source           String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  landingPage      String?
  deviceType       String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  paidAt           DateTime?

  items            OrderItem[]

  @@index([phone])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([utmSource])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  tariffId  String?
  tariff    Tariff?  @relation(fields: [tariffId], references: [id])
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model Lead {
  id                String   @id @default(cuid())
  name              String
  phone             String
  telegramUsername  String?
  email             String?
  productId         String?
  product           Product? @relation(fields: [productId], references: [id])

  source            String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?

  status            LeadStatus @default(NEW)

  createdAt         DateTime @default(now())

  @@index([phone])
  @@index([productId])
  @@index([status])
}

model AbandonedCheckout {
  id          String   @id @default(cuid())
  name        String?
  phone       String
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  tariffId    String?
  tariff      Tariff?  @relation(fields: [tariffId], references: [id])
  amount      Decimal? @db.Decimal(12, 2)
  stage       String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([createdAt])
}

model AnalyticsEvent {
  id          String              @id @default(cuid())
  type        AnalyticsEventType
  productId   String?
  product     Product?            @relation(fields: [productId], references: [id])
  sessionId   String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?

  createdAt   DateTime            @default(now())

  @@index([type])
  @@index([productId])
  @@index([createdAt])
  @@index([utmSource])
}
