# PostgreSQL ulanish satri. postgres.exe superuser paroli yoki shu loyiha uchun
# yaratilgan alohida user/parolni qo'ying. Masalan:
# DATABASE_URL="postgresql://postgres:PAROLINGIZ@localhost:5432/sotuv?schema=public"
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/sotuv?schema=public"

# JWT
JWT_SECRET="o'zgartiring-uzun-tasodifiy-maxfiy-kalit"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Admin panelda yuklangan mahsulot rasmlari/videolari shu papkada saqlanadi.
# Bo'sh qoldirilsa `backend/uploads` ishlatiladi. Fayllar `/api/uploads/...`
# manzili orqali tarqatiladi (rasm: JPEG/JPG/PNG, 15 MB; video: MP4, 50 MB).
UPLOAD_DIR=""

# Reklama havolalari generatori shu manzil asosida link quradi.
# Bo'sh qoldirilsa FRONTEND_URL ishlatiladi.
PUBLIC_SITE_URL=""

# Boshlang'ich admin (seed skripti shulardan foydalanadi).
# Admin panelga aynan shu telefon raqami va parol bilan kiriladi.
# Quyidagi qiymatlar — namuna; production'da albatta o'zgartiring.
SEED_ADMIN_PHONE="+998901234567"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Administrator"
