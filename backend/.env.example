# PostgreSQL ulanish satri. postgres.exe superuser paroli yoki shu loyiha uchun
# yaratilgan alohida user/parolni qo'ying. Masalan:
# DATABASE_URL="postgresql://postgres:PAROLINGIZ@localhost:5432/sotuv?schema=public"
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/sotuv?schema=public"

# JWT
JWT_SECRET="o'zgartiring-uzun-tasodifiy-maxfiy-kalit"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Boshlang'ich admin (seed skripti shulardan foydalanadi)
SEED_ADMIN_EMAIL="admin@sotuv.uz"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Administrator"

# Email xabarnomalari (ixtiyoriy — bo'sh qoldirilsa, xabar yuborish jim o'tkazib yuboriladi)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Sotuv Platformasi <no-reply@sotuv.uz>"
ADMIN_NOTIFY_EMAIL=""
